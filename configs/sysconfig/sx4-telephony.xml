<!-- Same as stock /system_ext/etc/sysconfig/com.android.phone.config.xml: lets the phone
     process use location during emergency calls even with location turned off. -->
<config>
    <allow-ignore-location-settings package="com.android.phone" attributionTag="*" />
</config>
