// Legacy fingerprint HAL module that forwards to the stock FPC HIDL 2.1
// service, so the AIDL fingerprint service from hardware/lineage can sit on top.
cc_library_shared {
    name: "fingerprint.sx4",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["FingerprintHidl.cpp"],
    header_libs: ["libhardware_headers"],
    shared_libs: [
        "android.hardware.biometrics.fingerprint@2.1",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
}
