# FM Radio (MT6631, same values as other MT6631 devices; no fake channels measured yet)
ro.fm.chip=0x6631
ro.fm.band=1
ro.fm.low_band=875
ro.fm.high_band=1080
ro.fm.seek_space=1
ro.fm.max_scan_num=40
ro.fm.seek_lev=4
ro.fm.scan_sort=0
ro.fm.short_ana_sup=1
ro.fm.rssi_th_l2=-102
ro.fm.noise_floor_detect=true

# Telephony (not settable from vendor)
ro.telephony.sim.count=2
