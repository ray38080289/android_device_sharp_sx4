# zram.ko is loaded from system_dlkm; same swap setup as stock without its
# module-swapping script (whose fih_zram.ko is not shipped anyway)
on property:sys.boot_completed=1
    write /sys/block/zram0/comp_algorithm lz4
    swapon_all /odm/etc/fstab.zram_swap.bd_disabled
