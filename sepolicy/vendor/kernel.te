# Display driver kworker adding mtkfb debugfs nodes
allow kernel debugfs_fb:dir search;

# krfcommd binding the RFCOMM L2CAP PSM; Android uses the userspace Bluetooth stack
dontaudit kernel self:capability net_bind_service;
