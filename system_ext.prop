# IMS
# Stock gets VoLTE availability from the modem (MtkImsManager, IMS config
# key 68); AOSP ImsManager has no such path, so override like device/xelex/Q25.
persist.dbg.volte_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
