// Applies Settings.Secure.DOUBLE_TAP_TO_WAKE to the touch driver: the stock
// power HAL ignores Mode.DOUBLE_TAP_TO_WAKE.
android_app {
    name: "Sx4TapToWake",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
}
